{
  "name": "manapack",
  "version": "0.1.0",
  "private": true,
  "description": "A schema-driven binary codec for real-time game messages: no field names or type tags on the wire, compiled encoders and decoders, per-socket string interning and deltas.",
  "keywords": [
    "binary",
    "codec",
    "game",
    "multiplayer",
    "netcode",
    "schema",
    "serialization",
    "websocket"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/verekia/manapack.git"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "bun check",
    "test": "bun test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "all": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxlint": "1.63.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
