enum Kind: uint8 {
  Unknown = 0;
  Player = 1;
  Monster = 2;
  Npc = 3;
}

enum Stance: uint8 {
  Unknown = 0;
  Idle = 1;
  Run = 2;
  Cast = 3;
  Stun = 4;
}

struct Entity {
  string id;
  string name;
  Kind kind;
  float32 x;
  float32 y;
  float32 rot;
  uint16 health;
  uint16 maxHealth;
  uint16 mana;
  byte level;
  bool alive;
}

struct Snapshot {
  uint64 t;
  Entity[] entities;
}

message Change {
  1 -> string id;
  2 -> float32 x;
  3 -> float32 y;
  4 -> float32 rot;
  5 -> float32 vx;
  6 -> float32 vy;
  7 -> uint16 health;
  8 -> uint16 mana;
  9 -> Stance stance;
}

struct Update {
  uint64 t;
  uint32 ack;
  Change[] updates;
}

message Action {
  1 -> string ability;
  2 -> string target;
}

struct Input {
  uint32 seq;
  uint64 t;
  float32 x;
  float32 y;
  float32 vx;
  float32 vy;
  float32 rot;
  string zone;
  Action[] actions;
}
